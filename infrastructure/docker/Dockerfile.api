# Eva API — production image (BRD 9.11: Docker packaging; Railway deploys this).
# Build context is the REPOSITORY ROOT (pnpm workspace).
# NOTE (2026-07-25): Railway "Wait for CI" is DISABLED on this service — it
# counted the systematically-failing "Dependabot Updates" check runs on main
# and skipped two merge deploys (dd37e5c, 6df7928). Branch protection already
# enforces green CI before merge, so the Railway gate was redundant.
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
WORKDIR /app

FROM base AS build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY infrastructure/database ./infrastructure/database
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile --filter @eva/api...
RUN pnpm --filter @eva/api... run build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
