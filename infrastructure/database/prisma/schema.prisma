// Eva — Phase 0 schema (BRD 10; Slice 0.2).
// Conventions (BRD 10): snake_case columns, tenant-owned rows carry
// organisation_id, mutable records carry created_at/updated_at/created_by,
// soft delete via deleted_at, all timestamps timestamptz (UTC, BRD 18.1).
// Phase 0 tables ONLY — invoicing/CRM/billing tables arrive with their phases
// (Rule 11: no placeholder debt).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  /// Demo/seed organisations are excluded from any real sending (BRD 18.6).
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  settings        OrganisationSettings?
  memberships     OrganisationMembership[]
  auditLogs       AuditLog[]
  customers       Customer[]
  contacts        Contact[]
  invoices        Invoice[]
  imports         Import[]
  importRows      ImportRow[]
  invoiceDocuments InvoiceDocument[]
  suppressionEvents SuppressionEvent[]
  rolePermissions OrganisationRolePermission[]
  reminderSequences ReminderSequence[]
  reminderSteps     ReminderStep[]
  scheduledActions  ScheduledAction[]
  humanEscalations  HumanEscalation[]
  emailAccounts   EmailAccount[]
  modules         OrganisationModule[]
  leads           Lead[]
  leadEvidence    LeadEvidence[]
  consentTexts    ConsentText[]
  inboundAddresses InboundAddress[]
  inboundMessages  InboundMessage[]
  inboundForwardingRequests InboundForwardingRequest[]
  leadReplyTemplates LeadReplyTemplate[]
  leadReplyDecisions LeadReplyDecision[]
  channelConnections ChannelConnection[]
  inboundChannelMessages InboundChannelMessage[]

  @@map("organisations")
}

model OrganisationSettings {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @unique @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// All business logic runs in this timezone (BRD 18.1).
  timezone       String       @default("Europe/London")
  locale         String       @default("en-GB")
  /// What a new invoice's currency dropdown OPENS ON (slice 1.6c, task 13).
  ///
  /// ⚠️ A DEFAULT, NEVER A RESTRICTION (founder ruling 2026-08-04). Currency is
  /// per INVOICE and stays that way: a UK seller with buyers in Singapore and
  /// the UAE holds GBP, SGD and AED in one book, and this must never stop them
  /// raising a USD invoice. It exists so a Dubai business stops typing AED
  /// fifty times a week, and for no other reason.
  defaultCurrency String      @default("GBP") @map("default_currency")
  /// Shapes refined when the modules that consume them land (Phases 1-4).
  /// Calling hours default to the UK 08:00-21:00 rule (BRD 17) but are per-org
  /// CONFIGURATION, not a code constant — BRD 18.7 (jurisdiction-as-config)
  /// supersedes any hard UK clamp, since the launch market is UK but GCC and
  /// US follow (18.7.1). Phase 2 must read these, never hardcode a country.
  businessHours  Json?        @map("business_hours")
  callingHours   Json?        @map("calling_hours")
  /// How the debtor actually pays — bank details, or whatever the customer
  /// wants quoted in a chaser. A chasing email that does not answer "how do I
  /// pay you?" is half a product. NEVER a credential and never card details:
  /// Eva does not touch the customer's money.
  paymentInstructions String? @map("payment_instructions")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@map("organisation_settings")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  /// Lowercased by the application layer before write.
  email       String    @unique
  fullName    String?   @map("full_name")
  /// Links to Supabase Auth (auth.users.id); populated in Slice 0.3.
  authUserId  String?   @unique @map("auth_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Last request this user made, for the two-day idle sign-out. NULL means
  /// "not seen since the column shipped" and is treated as fresh, never stale —
  /// see isSessionIdle in @eva/types.
  /// ⚠️ NOT THE SECURITY INPUT ANY MORE — see UserSession. This is "last seen
  /// anywhere", kept for support questions. The idle rule reads the per-session
  /// stamp, because one timestamp per person cannot tell a busy laptop apart
  /// from a stolen phone.
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  /// ⚠️ DEPRECATED BY `UserSession` AND NO LONGER READ. Superseded within a day
  /// of shipping (0032 -> 0033): one column could hold only one session, which
  /// is precisely the hole. Left in place rather than dropped in the same
  /// change, because dropping it while the previous release is still serving
  /// requests would 500 every one of them. Drop it in its own migration, applied
  /// AFTER a deploy that no longer reads it.
  lastSessionId String? @map("last_session_id")
  memberships OrganisationMembership[]
  auditLogs   AuditLog[]
  sessions    UserSession[]

  @@map("users")
}

/// One activity stamp per (user, Supabase session) — the two-day idle rule
/// (ruling 37, corrected 2026-08-25).
///
/// ⚠️ A ROW IS A CLOCK, NOT A PERMISSION. Its absence means "never seen", which
/// is read as a new sign-in and admitted; its presence with a stale stamp is
/// what refuses a replayed session. So deleting rows to save space would hand
/// every deleted session a fresh start — nothing prunes this table. See the
/// migration's ROLLBACK.md.
model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// The Supabase `session_id` claim. TEXT, not UUID: it is somebody else's
  /// value and a type error here would land on the sign-in path.
  sessionId  String   @map("session_id")
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@map("user_sessions")
}

/// The six roles of BRD 7, seeded by src/seed.ts.
model Role {
  id              String                       @id @default(uuid()) @db.Uuid
  key             String                       @unique
  name            String
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships     OrganisationMembership[]
  rolePermissions OrganisationRolePermission[]

  @@map("roles")
}

model OrganisationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@unique([organisationId, userId])
  @@map("organisation_memberships")
}

/// Append-only audit trail (BRD 15): never updated, never soft-deleted.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  /// Null for system actions.
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id])

  @@index([organisationId, createdAt])
  @@map("audit_logs")
}

// --- Slice 1.1: CRM core + data-driven permissions (BRD 10; plan §7 ruling) ---

/// A business the organisation sells to / is owed money by (BRD 10 — CRM core).
model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  name           String
  /// Lowercased by the application layer before write.
  email          String?
  phone          String?
  /// The organisation's own account reference for this customer.
  reference      String?
  /// This customer's default terms; the invoice carries what was agreed.
  paymentTerms   String?      @map("payment_terms")
  /// Provenance + remote identity (migration 0019), so a re-sync updates rather
  /// than duplicates. The partial unique index on
  /// (organisation_id, source, external_id) WHERE external_id IS NOT NULL lives
  /// in the migration: partial indexes are not representable here.
  source         String       @default("manual")
  externalId     String?      @map("external_id")
  /// Which mailbox chases this client (slice 1.6b, ruling 1). NULL is the
  /// normal state and means "chase from the organisation's DEFAULT mailbox" —
  /// never "do not chase". Resolution happens at SEND time, every time; nothing
  /// stamps a mailbox id onto a client, or a change of default would silently
  /// keep sending from the old address (ALLOCATION-SCOPE trap 1).
  ///
  /// The foreign key is COMPOSITE — (organisation_id, email_account_id) — so a
  /// client can only ever point at a mailbox in its own organisation. RLS here
  /// checks the customer's tenant and never looks at the mailbox, so without it
  /// nothing but application code prevents one company's chasing letters going
  /// out from another company's address. It lives in migration 0020 and is
  /// mirrored below so Prisma does not see drift.
  emailAccountId String?      @map("email_account_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// onDelete: Restrict — the application never hard-deletes a mailbox
  /// (disconnect soft-deletes and nulls the tokens), so this only fires on
  /// manual database surgery, where failing loudly beats silently re-filing a
  /// whole book of clients onto the default address.
  emailAccount   EmailAccount? @relation(fields: [organisationId, emailAccountId], references: [organisationId, id], onDelete: Restrict, map: "customers_email_account_same_org_fkey")
  contacts       Contact[]
  invoices       Invoice[]
  /// Enquiries recognised as coming from this existing client (BRD 4.3 lists
  /// "existing customer requesting another service" as an eligible source).
  leads          Lead[]

  @@index([organisationId])
  @@map("customers")
}

/// A person at a customer — reminders are addressed to contacts (BRD 10).
/// organisation_id is denormalised onto every tenant-owned row so the RLS
/// tenant_isolation policy stays uniform.
model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  name           String
  /// Lowercased by the application layer before write.
  email          String?
  phone          String?
  jobTitle       String?      @map("job_title")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@index([organisationId])
  @@index([customerId])
  @@map("contacts")
}

// --- Slice 1.2: invoice records (BRD 4.1/10; Phase 1.2 plan §3) ---

/// An amount owed by a customer (BRD 10). Status is one of the nine STORED
/// statuses (CHECK constraint in migration 0006): draft, active, paused,
/// cancelled, promise_to_pay, disputed, partially_paid, paid, written_off.
/// due_soon/due_today/overdue are NOT stored — they are derived at read time
/// from due_date + the organisation timezone (plan §7.1). status changes only
/// via the invoices module state machine (BRD 4.1 hard rule).
/// Uniqueness of invoice_number per organisation among live rows is enforced
/// by a partial unique index (migration 0006), so a soft-deleted invoice's
/// number can be reused.
model Invoice {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  /// Optional link to the person reminders are addressed to (plan §7.2);
  /// SET NULL when the contact is deleted.
  contactId        String?      @map("contact_id") @db.Uuid
  /// The organisation's own invoice number (unique per org among live rows).
  invoiceNumber    String       @map("invoice_number")
  /// Integer minor units — money is never float (BRD 10). How many digits a
  /// "minor unit" has depends on the CURRENCY, not on a constant 100: 0 for
  /// JPY/VND, 2 for GBP/AED/USD, 3 for KWD/BHD/OMR. See packages/types money.ts.
  /// BIGINT since migration 0021 — INTEGER capped a Vietnamese invoice at
  /// roughly $86k, and at ~$860 under the pre-1.6c x100 code.
  amountMinorUnits BigInt       @map("amount_minor_units")
  /// Paid so far (migration 0019). BALANCE IS DERIVED — `amount - paid` — and
  /// is never stored: a third number can disagree with the other two. Eva
  /// chases the balance, never the total; status `partially_paid` has existed
  /// since 0006 with no number to go with it until now.
  /// Overpayment is ALLOWED (founder ruling): the CHECK is `>= 0` only, the
  /// balance clamps at zero, and Eva stops chasing. We are not accountants.
  amountPaidMinorUnits BigInt   @default(0) @map("amount_paid_minor_units")
  currency         String       @default("GBP") @db.Char(3)
  issueDate        DateTime     @map("issue_date") @db.Date
  dueDate          DateTime     @map("due_date") @db.Date
  /// Someone who part-paid three days ago must not get the same message as
  /// someone who has paid nothing in ninety days.
  lastPaymentAt    DateTime?    @map("last_payment_at") @db.Timestamptz(6)
  /// The DEBTOR's own reference (Zoho calls it Order Number). Quoting it back
  /// cuts "which invoice is this?" replies. Distinct from `customers.reference`,
  /// which is our customer's own account ref for that debtor.
  customerReference String?     @map("customer_reference")
  /// What was actually agreed ("Net 30"). Free text, not an enum — every
  /// accounting package words these differently and we import theirs.
  paymentTerms     String?      @map("payment_terms")
  /// ONE line of context ("Bathroom renovation, final"), from the first line
  /// item on import. NOT line items — a bare amount makes a weak chaser.
  description      String?
  /// Which system this row came from; half of the identity that lets a re-sync
  /// update rather than duplicate. NOT the same idea as
  /// `organisation_modules.source`, which records how a product was paid for.
  source           String       @default("manual")
  externalId       String?      @map("external_id")
  status           String       @default("draft")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  importRows       ImportRow[]
  invoiceDocuments InvoiceDocument[]
  scheduledActions ScheduledAction[]
  humanEscalations HumanEscalation[]

  @@index([organisationId])
  @@index([customerId])
  @@map("invoices")
}

// --- Slice 1.3: CSV/Excel invoice import (BRD 4.1/10/15/16; Phase 1.3 plan §3/§7) ---

/// One row per uploaded import file (plan §7.1: persisted two-phase import).
/// The file itself is NEVER persisted — held in memory, parsed, discarded
/// (BRD 16 data minimisation); only staged rows in import_rows survive.
/// status is one of uploaded | completed | failed | cancelled (CHECK
/// constraint in migration 0007); 'confirmed' is not a stored state — confirm
/// runs synchronously to completion (plan §7.8). Status changes only via the
/// imports module status machine (the 1.2 pattern).
model Import {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  originalFilename String       @map("original_filename")
  /// csv | xlsx (CHECK constraint in migration 0007). Legacy .xls rejected.
  fileType         String       @map("file_type")
  status           String       @default("uploaded")
  /// Resolved file-column → canonical-field mapping (echoed to the client).
  mapping          Json
  totalRows        Int          @default(0) @map("total_rows")
  validRows        Int          @default(0) @map("valid_rows")
  invalidRows      Int          @default(0) @map("invalid_rows")
  duplicateRows    Int          @default(0) @map("duplicate_rows")
  suppressedRows   Int          @default(0) @map("suppressed_rows")
  createdRows      Int          @default(0) @map("created_rows")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rows             ImportRow[]

  @@index([organisationId])
  @@map("imports")
}

/// A staged parse result — one row per data row of the uploaded file
/// (plan §3). organisation_id is denormalised onto every tenant-owned row so
/// the RLS tenant_isolation policy stays uniform (the contacts precedent).
/// No deleted_at: lifecycle follows the parent import via cascade.
/// status is one of valid | invalid | duplicate | suppressed | imported |
/// skipped (CHECK constraint in migration 0007).
model ImportRow {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  importId         String       @map("import_id") @db.Uuid
  /// 1-based position of the data row in the uploaded file.
  rowNumber        Int          @map("row_number")
  /// The original file row (file column names → raw string values).
  raw              Json
  status           String
  /// Row-level validation errors (jsonb string array); empty when valid.
  errors           Json         @default("[]")
  /// The Draft invoice created at confirm (plan §7.7); SET NULL if that
  /// invoice is deleted.
  createdInvoiceId String?      @map("created_invoice_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  import           Import       @relation(fields: [importId], references: [id], onDelete: Cascade)
  createdInvoice   Invoice?     @relation(fields: [createdInvoiceId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([importId])
  @@map("import_rows")
}

// --- Slice 1.4: PDF invoice extraction (BRD 4.1/10/15/16; Phase 1.4 plan §3/§7) ---

/// One uploaded single-invoice PDF plus its extraction outcome (plan §3).
/// Unlike imports (1.3), the PDF itself IS persisted in `content` (bytea,
/// RLS-protected — plan §7.2): review needs source-beside-fields, the
/// manual-entry fallback needs the file readable, and it is the attachment
/// source when Outlook sending lands in slice 1.7 (BRD 16).
/// status is one of uploaded | extracted | confirmed | failed (CHECK
/// constraint in migration 0008); status changes only via the
/// invoice-documents module status machine (the 1.2/1.3 pattern).
model InvoiceDocument {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  originalFilename String       @map("original_filename")
  sizeBytes        Int          @map("size_bytes")
  /// The PDF bytes (plan §7.2). Never logged (BRD 14); streamed back only
  /// through the tenant-scoped file endpoint.
  content          Bytes
  status           String       @default("uploaded")
  /// Extraction draft: per canonical field `{ value, confidence }` plus
  /// extraction notes (plan §3); null until extraction has run.
  extractedFields  Json?        @map("extracted_fields")
  /// Sanitised, actionable failure reason when status = 'failed' (plan §3) —
  /// never raw extractor internals.
  extractionError  String?      @map("extraction_error")
  /// The Draft invoice created at confirm (plan §7.7); SET NULL if that
  /// invoice is deleted.
  invoiceId        String?      @map("invoice_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice          Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@map("invoice_documents")
}

/// Cross-channel do-not-contact, as an APPEND-ONLY LOG OF EVENTS rather than a
/// list of values (migration 0028). BRD hard rule: a request is actioned
/// immediately and permanently, across all channels.
///
/// ⚠️ A ROW IS NOT "THIS VALUE IS SUPPRESSED". It is "on this date, somebody
/// did this". `action` is `suppress` or `correct`, and the CURRENT state of a
/// value is whatever its NEWEST row says — never `EXISTS(...)`, which was the
/// right question up to 0027 and is a bug after it. Read it through
/// `suppression.ts`; a hand-written query that ignores `action` will silently
/// treat a corrected entry as live.
///
/// ⚠️ NO updated_at / deleted_at, AND `eva_app` HOLDS NO UPDATE OR DELETE
/// (migration 0005, re-asserted by 0028). That is what makes "permanent" a
/// database fact rather than an app convention, and it is exactly why undoing
/// a mis-click had to become a new row rather than an edit.
///
/// ⚠️ THE UNIQUE KEY ON (org, channel, value) WAS DROPPED BY 0028 and could not
/// survive: a value that is suppressed, corrected, then genuinely asked for
/// again needs a SECOND `suppress` row, and a genuine request that silently did
/// nothing is the worst bug this table could have. Idempotency moved into
/// `addSuppression`, which does not write when the value is already suppressed.
///
/// Channels: email | call (whatsapp added additively when Phase 3 needs it).
model SuppressionEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  /// `suppress` | `correct` — CHECK-constrained in migration 0028.
  action         String       @default("suppress")
  channel        String
  /// The address/number, normalised by the application layer.
  value          String
  /// Why. Optional on a suppression, REQUIRED on a correction (CHECK).
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The lookup every send path makes: newest row for one value on one channel.
  @@index([organisationId, channel, value, createdAt])
  @@map("suppression_events")
}

/// Per-organisation role→permission grants (BRD 7 amendment, Slice 1.1 plan
/// §7.1). An org with ZERO rows uses the coded BRD default matrix
/// (DEFAULT_ROLE_PERMISSIONS in @eva/types); rows appear only when an
/// owner/administrator saves a custom mapping (full-replace PUT, audit-logged).
/// Rows are replaced, not edited in place — history lives in audit_logs.
model OrganisationRolePermission {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  permissionKey  String       @map("permission_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organisationId, roleId, permissionKey])
  @@map("organisation_role_permissions")
}

// --- Slice 1.5: reminder sequence (BRD 4.1/10; Phase 1.5 plan §3) ---

/// The organisation's reminder sequence of BRD 4.1 stages (plan §3). One
/// default per organisation among LIVE rows is enforced by a partial unique
/// index (migration 0009), so a soft-deleted default can be replaced.
model ReminderSequence {
  id             String          @id @default(uuid()) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  name           String
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?         @map("created_by") @db.Uuid
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  steps          ReminderStep[]

  @@index([organisationId])
  @@map("reminder_sequences")
}

/// One BRD 4.1 stage of a sequence (plan §3). key is one of pre_due_3 |
/// due_date | overdue_7 | overdue_14 | overdue_30 | final_escalation and
/// action_type one of email | internal_escalation (CHECK constraints in
/// migration 0009). offset_days is relative to the invoice due_date
/// (negative = before). organisation_id is denormalised onto every
/// tenant-owned row so the RLS tenant_isolation policy stays uniform (the
/// contacts precedent). Uniqueness of key per sequence among live rows is
/// enforced by a partial unique index (migration 0009).
model ReminderStep {
  id               String            @id @default(uuid()) @db.Uuid
  organisationId   String            @map("organisation_id") @db.Uuid
  sequenceId       String            @map("sequence_id") @db.Uuid
  key              String
  offsetDays       Int               @map("offset_days")
  actionType       String            @map("action_type")
  enabled          Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?           @map("created_by") @db.Uuid
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sequence         ReminderSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  scheduledActions ScheduledAction[]

  @@index([organisationId])
  @@index([sequenceId])
  @@map("reminder_steps")
}

/// One durable send-queue row: a reminder (or internal escalation) due on an
/// org-local calendar day (plan §3). status is the full lifecycle — pending |
/// ready | claimed | sent | failed | skipped | cancelled (CHECK constraint in
/// migration 0009, the 1.2 invoice-status precedent); slice 1.5 writes only
/// pending/ready/cancelled, 1.7 drives the rest. action_type is denormalised
/// from the step so escalations fire without a step join. UNIQUE
/// (invoice_id, reminder_step_id, scheduled_date) is the BRD 4.1 mandatory
/// duplicate prevention; idempotency_key is the deterministic uuidv5 of
/// invoice+step+date, generated app-side. No deleted_at: a lifecycle/queue
/// record — cancelled is terminal.
model ScheduledAction {
  id              String           @id @default(uuid()) @db.Uuid
  organisationId  String           @map("organisation_id") @db.Uuid
  invoiceId       String           @map("invoice_id") @db.Uuid
  reminderStepId  String           @map("reminder_step_id") @db.Uuid
  actionType      String           @map("action_type")
  /// The org-local calendar day the action is due (like invoices.due_date).
  scheduledDate   DateTime         @map("scheduled_date") @db.Date
  status          String           @default("pending")
  idempotencyKey  String           @map("idempotency_key")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid
  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reminderStep    ReminderStep     @relation(fields: [reminderStepId], references: [id], onDelete: Cascade)
  humanEscalation HumanEscalation?

  /// BRD 4.1 duplicate prevention over LIVE rows only: uniqueness of
  /// (invoice_id, reminder_step_id, scheduled_date) WHERE status <> 'cancelled'
  /// is enforced by a partial unique index (migration 0011, the 0009
  /// precedent). A cancelled slot can be re-filled by a fresh insert —
  /// cancelled is terminal, rows are never revived.
  @@index([organisationId])
  @@index([status, scheduledDate])
  @@map("scheduled_actions")
}

/// A platform workflow record raised when the final reminder fires (plan §3).
/// scheduled_action_id is UNIQUE — one escalation per fired step (the dedup).
/// status is open | resolved (CHECK constraint in migration 0009); resolution
/// is its lifecycle, so no deleted_at.
model HumanEscalation {
  id                String          @id @default(uuid()) @db.Uuid
  organisationId    String          @map("organisation_id") @db.Uuid
  invoiceId         String          @map("invoice_id") @db.Uuid
  scheduledActionId String          @unique @map("scheduled_action_id") @db.Uuid
  reason            String
  status            String          @default("open")
  resolvedAt        DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolvedBy        String?         @map("resolved_by") @db.Uuid
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.Uuid
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  scheduledAction   ScheduledAction @relation(fields: [scheduledActionId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("human_escalations")
}

/// A connected Microsoft 365 mailbox (Slice 1.6; BRD §8 email_accounts).
/// OAuth tokens are AES-256-GCM ciphertext (v1.<iv>.<tag>.<ct> base64 — see
/// apps/api common/crypto), NEVER plaintext; both are nulled on disconnect
/// (ruling 8). health_status is active | auth_expired | error (CHECK in
/// migration 0013). One LIVE connection per organisation: partial unique
/// index WHERE deleted_at IS NULL (ruling 6, the 0011 precedent).
model EmailAccount {
  id                    String       @id @default(uuid()) @db.Uuid
  organisationId        String       @map("organisation_id") @db.Uuid
  /// Which PRODUCT this mailbox belongs to (ruling 36, migration 0034). A
  /// mailbox serves exactly one product: two products mean two connections,
  /// two seats and two OAuth grants, even for the same address.
  ///
  /// ⚠️ NO DEFAULT, ON PURPOSE. Migration 0034 adds the column with one, uses
  /// it to back-fill, then drops it — so any insert that does not name a
  /// product fails loudly rather than silently filing the mailbox under
  /// Invoice Chasing. Constrained to `MODULE_KEYS` by
  /// `email_accounts_module_key_check`, which `mailbox-module-keys.spec.ts`
  /// keeps in step with the TypeScript list.
  ///
  /// ⚠️ NOT A SECURITY BOUNDARY. The tenant boundary is `organisation_id` and
  /// RLS enforces only that. Both products belong to the same tenant, so
  /// scoping a query by product is the API's job, never the database's.
  moduleKey             String       @map("module_key")
  provider              String       @default("microsoft")
  emailAddress          String       @map("email_address")
  displayName           String?      @map("display_name")
  accessTokenEncrypted  String?      @map("access_token_encrypted")
  refreshTokenEncrypted String?      @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?    @map("token_expires_at") @db.Timestamptz(6)
  scopes                String[]
  healthStatus          String       @default("active") @map("health_status")
  lastHealthCheckAt     DateTime?    @map("last_health_check_at") @db.Timestamptz(6)
  lastError             String?      @map("last_error")
  connectedBy           String?      @map("connected_by") @db.Uuid
  /// The mailbox a product sends from. Exactly one per organisation PER
  /// PRODUCT since migration 0034 — it was one per organisation from 0017
  /// until then, which is why the second product could not have a default at
  /// all. Enforced by a partial unique index that schema.prisma cannot express.
  isPrimary             Boolean      @default(false) @map("is_primary")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?      @map("created_by") @db.Uuid
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Clients filed under this mailbox (slice 1.6b). Unallocated clients are
  /// NOT here — they fall back to the primary at send time (ruling 1).
  customers             Customer[]

  @@index([organisationId])
  /// Redundant against the primary key, and deliberately so: it is the target a
  /// composite foreign key needs, and it is what makes a cross-tenant client
  /// allocation impossible in the database rather than merely unlikely in code.
  @@unique([organisationId, id])
  /// ⚠️ THREE MORE INDEXES LIVE IN MIGRATIONS AND NOT HERE, because all three
  /// are PARTIAL (`WHERE deleted_at IS NULL`) and Prisma cannot express that:
  /// `email_accounts_live_address_key` (one address per organisation per
  /// product), `email_accounts_single_primary_key` (one default per
  /// organisation per product) and `email_accounts_organisation_module_idx`
  /// (the lookup every seat count, readiness check and send now makes). All
  /// three were re-scoped from "per organisation" by migration 0034.
  @@map("email_accounts")
}

/// Which of the four products an organisation holds, and how many units of
/// each it has paid for. Absence of a row means NOT entitled — fail closed.
///
/// The partial unique index on (organisation_id, module_key) WHERE deleted_at
/// IS NULL lives in migration 0017: partial indexes are not representable
/// here, the 0011/0013 precedent.
model OrganisationModule {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  moduleKey      String       @map("module_key")
  enabled        Boolean      @default(true)
  /// How it was turned on: subscription | manual | trial.
  source         String       @default("manual")
  /// Units paid for — a connected mailbox for the email credit controller.
  /// NOT NULL by design: a NULL meaning "unlimited" would fail open.
  seats          Int          @default(1)
  enabledAt      DateTime?    @map("enabled_at") @db.Timestamptz(6)
  disabledAt     DateTime?    @map("disabled_at") @db.Timestamptz(6)
  /// When a product switched off mid-period actually stops — the end of the
  /// period already paid for (founder ruling 2026-08-19). `enabled = true`
  /// WITH `ends_at` set is the normal cancelled state, not a contradiction:
  /// the customer has cancelled and is still using what they bought.
  /// `disabled_at` records when it stopped; this is only ever about the future.
  /// The CHECK in migration 0024 (`ends_at IS NULL OR enabled`) is what forces
  /// "the end arrived" to be one statement rather than two.
  endsAt         DateTime?    @map("ends_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("organisation_modules")
}

/// Slice 3.1a — the lead record.
///
/// ⚠️ A LEAD IS NOT A CUSTOMER, AND NOT A CONTACT. It is somebody who got in
/// touch and has not been answered yet. `customerId` is set only once we
/// recognise them as an existing client (BRD 4.3 lists "existing customer
/// requesting another service" as an eligible source), and stays null for the
/// strangers who are the point of the product.
model Lead {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// The BRD 4.3 channel this arrived through. `email_enquiry` is the only
  /// value this product produces (ruling 29 — one mailbox in, a reply out); the
  /// three call-shaped sources were retired in #100 and stay legal only for the
  /// rows that already carry them. Migration 0027 explains why widening a CHECK
  /// is not the same as reopening a door: the API is what refuses them now.
  source         String
  contactName    String?   @map("contact_name")
  contactEmail   String?   @map("contact_email")
  contactPhone   String?   @map("contact_phone")
  /// What they asked for, as received. Null for a missed call, which has a
  /// number and no words — inventing a summary would put words in a customer's
  /// mouth on a compliance record.
  enquiry        String?
  /// `new` or `do_not_contact`. 3.1c adds the states that need Eva to answer;
  /// a status nothing can set is the `endsAt` trap from migration 0024.
  status         String    @default("new")
  /// ⚠️ THEIR CLOCK, NOT OURS. Speed-to-lead is measured from when the enquiry
  /// HAPPENED. A Friday missed call logged on Monday is three days old, and a
  /// target measured from `createdAt` would call it instant.
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  firstRespondedAt DateTime? @map("first_responded_at") @db.Timestamptz(6)
  customerId     String?   @map("customer_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  evidence       LeadEvidence?
  /// The delivery this lead was derived from (3.1b). A list on the Prisma side
  /// because a foreign key has no cardinality of its own; in practice one, and
  /// `inbound_messages.provider_message_id` being unique is what keeps it one.
  inboundMessages InboundMessage[]
  /// The channel delivery this lead was derived from (3.2c → 3.3). Same
  /// cardinality argument as `inboundMessages`; the provider id is unique.
  inboundChannelMessages InboundChannelMessage[]
  /// What Eva decided about this enquiry (3.1c-3). At most one live row.
  replyDecision   LeadReplyDecision[]

  @@index([organisationId])
  @@index([organisationId, receivedAt(sort: Desc)])
  @@map("leads")
}

/// Why this lead is allowed to be contacted at all (BRD 4.3, "Consent
/// evidence").
///
/// ⚠️ WRITTEN ONCE, NEVER UPDATED — AND THE DATABASE IS WHAT ENFORCES IT.
/// `eva_app` holds SELECT and INSERT on this table and nothing else, so there
/// is no UPDATE for a service to forget to avoid. Lead follow-up is
/// marketing-adjacent under PECR: the difference between a lawful response and
/// an unlawful one is whether we can prove the person contacted us first, and
/// evidence that can be edited proves nothing.
///
/// No `updatedAt`, deliberately — there is no update to stamp.
model LeadEvidence {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  leadId            String    @unique @map("lead_id") @db.Uuid
  channel           String
  /// The provider's own id where one exists (Graph message id, call id).
  externalId        String?   @map("external_id")
  senderAddress     String?   @map("sender_address")
  recipientAddress  String?   @map("recipient_address")
  subject           String?
  /// When the enquiry happened, from the channel's own record.
  occurredAt        DateTime  @map("occurred_at") @db.Timestamptz(6)
  consentTextId     String?   @map("consent_text_id") @db.Uuid
  /// Verbatim, so the evidence outlives the mailbox it came from.
  rawExcerpt        String?   @map("raw_excerpt")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead              Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consentText       ConsentText? @relation(fields: [consentTextId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("lead_evidence")
}

/// The wording somebody agreed to, frozen (BRD 4.3: "Consent text versions must
/// be immutable records so evidence remains provable").
///
/// An edit is a NEW version, never an overwrite — enforced the same way as
/// `LeadEvidence`, by withholding UPDATE from `eva_app`. Nothing in 3.1a
/// writes these: all three of its sources are direct inbound contact, which
/// needs no consent text. The table exists now because evidence references it,
/// and back-filling a reference into historical evidence is the thing that
/// cannot be done honestly later.
model ConsentText {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  version        Int
  body           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  evidence       LeadEvidence[]

  @@unique([organisationId, version])
  @@index([organisationId])
  @@map("consent_texts")
}

/// Where a customer's enquiries land — the front door (Slice 3.1b, ruling 29).
///
/// ⚠️ AN ADDRESS WE OWN, NOT THE CUSTOMER'S MAILBOX (ruling 25). The business
/// puts this one address on their website and their lead forms; mail arriving
/// here becomes a lead, and Eva's reply goes out from the customer's own
/// mailbox. Nobody is ever asked for a restricted Google scope.
///
/// ⚠️ `domain` IS A COLUMN BECAUSE IT WILL CHANGE ONCE. Ruling 34 starts this on
/// Resend's free `*.resend.app` domain and moves it to one we own before the
/// first sale. Stored, that move is an UPDATE; derived, it would silently
/// invalidate every address already printed on a customer's website.
///
/// The unique index on `address` covers revoked rows too, and migration 0029
/// explains why at length: an address we have ever issued is spent forever.
model InboundAddress {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  /// Lowercased, and the database enforces it — a service that forgets fails on
  /// INSERT rather than quietly issuing a second, unroutable door.
  address        String    @unique
  localPart      String    @map("local_part")
  domain         String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  /// Revoking is a soft delete plus a NEW row. One live address per
  /// organisation, enforced by a partial unique index migration 0029 carries
  /// and schema.prisma cannot express (the 0011/0013/0017 precedent).
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// ⚠️ A WINDOW, NOT A PERMISSION (migration 0031). Set when a customer stands
  /// on the guided forwarding screen and says they are setting it up now, and
  /// meaningful only for the few minutes after. It is what lets Eva answer
  /// Google's confirmation email for them instead of making them hunt for a
  /// code — and its expiry is what stops a guessed address being confirmed for
  /// a stranger a year later. The length lives in the service, with a test.
  forwardingArmedAt DateTime? @map("forwarding_armed_at") @db.Timestamptz(6)
  forwardingArmedBy String?   @map("forwarding_armed_by") @db.Uuid
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  messages       InboundMessage[]
  forwardingRequests InboundForwardingRequest[]

  @@index([organisationId])
  @@map("inbound_addresses")
}

/// Who asked to forward mail into this organisation's book, and what we did.
///
/// ⚠️ THE ROW EXISTS BECAUSE "CONFIRM IT FOR THEM" MUST NOT MEAN "CONFIRM
/// ANYTHING THAT ASKS". Google's confirmation email is the second lock on a
/// door whose first lock is ruling 33's random tail: mail cannot be forwarded
/// to an address until that address's owner agrees, and the owner is us.
/// Answering every request automatically would hand anyone who guesses an
/// address a silent feed into that customer's enquiries — and, once 3.1c
/// ships, a way to make Eva reply to strangers in that customer's name.
///
/// So a request that arrives inside the armed window is confirmed for the
/// customer, and one that arrives outside it is shown to them and left alone.
model InboundForwardingRequest {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  inboundAddressId String    @map("inbound_address_id") @db.Uuid
  /// ⚠️ THE IDEMPOTENCY KEY. Gmail resends and webhooks retry; keying to the
  /// message means a replay updates nothing rather than asking twice.
  inboundMessageId String    @unique @map("inbound_message_id") @db.Uuid
  /// The mailbox that wants to forward, read out of Google's own message — NOT
  /// the envelope sender, which is `forwarding-noreply@google.com` for every
  /// request from every account on earth and so identifies nobody.
  sourceAddress    String    @map("source_address")
  /// Both halves of Google's message. We answer with the URL; the code is the
  /// fallback the screen shows if that ever stops working, so the feature
  /// degrades to three clicks rather than to silence.
  confirmationCode String?   @map("confirmation_code")
  confirmationUrl  String?   @map("confirmation_url")
  /// pending | confirmed | declined. There is deliberately no `failed`: a
  /// failed attempt leaves the request OPEN, with `failureReason` set, because
  /// the code is still valid and the customer can still finish it by hand.
  status           String    @default("pending")
  failureReason    String?   @map("failure_reason")
  settledAt        DateTime? @map("settled_at") @db.Timestamptz(6)
  /// ⚠️ NULL MEANS EVA DID IT, NOT THAT NOBODY DID. The screen says which,
  /// because "Eva confirmed this for you" and "you confirmed this" are
  /// different facts about the customer's own security.
  settledBy        String?   @map("settled_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  address          InboundAddress @relation(fields: [inboundAddressId], references: [id], onDelete: Restrict)
  message          InboundMessage @relation(fields: [inboundMessageId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([organisationId, status, createdAt(sort: Desc)])
  @@map("inbound_forwarding_requests")
}

/// What arrived at the front door, written before anything is decided about it.
///
/// ⚠️ THIS IS THE ONLY COPY. The enquiry was forwarded to us; the customer's own
/// mailbox is not somewhere we can go back and re-read it from (ruling 25). So
/// the row is written from the webhook's metadata at the moment of arrival, and
/// the body is fetched into it afterwards — because Resend's `email.received`
/// webhook carries METADATA ONLY, and that second call can fail on its own.
///
/// ⚠️ NOT EVIDENCE, AND NOT APPEND-ONLY. `LeadEvidence` is the record PECR
/// expects us to show and the database refuses to change it. This is the
/// working record of a delivery: it keeps UPDATE because the body lands late
/// and the status moves. If anything here is ever cited as proof that somebody
/// made contact, it belongs in `LeadEvidence` instead.
model InboundMessage {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  inboundAddressId  String    @map("inbound_address_id") @db.Uuid
  provider          String    @default("resend")
  /// ⚠️ THE IDEMPOTENCY KEY. Webhooks retry — on a non-2xx, on a timeout, and
  /// on successes the sender never heard about. Unique per provider, so the
  /// second delivery of the same message is a no-op instead of a duplicate
  /// enquiry in somebody's book.
  providerMessageId String    @map("provider_message_id")
  /// The sender's own RFC 5322 Message-ID. Not our key (the sender chooses it
  /// and a forwarder may rewrite it) but it is what a reply quotes to thread.
  rfcMessageId      String?   @map("rfc_message_id")
  fromAddress       String    @map("from_address")
  /// The address the provider says it delivered to, verbatim. Kept beside the
  /// resolved `inboundAddressId` because the two disagreeing is the routing bug
  /// that is invisible without both halves written down.
  deliveredTo       String    @map("delivered_to")
  subject           String?
  textBody          String?   @map("text_body")
  htmlBody          String?   @map("html_body")
  /// ⚠️ THE LOOP-STOPPER (ruling 32). `Auto-Submitted`, `Precedence: bulk` and
  /// `List-*` are how Eva will know not to answer another machine — and
  /// answering another auto-responder is a loop that runs on the CUSTOMER'S
  /// domain, in their name. Captured from this slice onward, before the rules
  /// that read them exist, because a header not kept at arrival is gone.
  headers           Json?
  /// received | converted | ignored | failed. Only states that can occur —
  /// migration 0029 sets out what produces each one.
  status            String    @default("received")
  failureReason     String?   @map("failure_reason")
  leadId            String?   @map("lead_id") @db.Uuid
  /// ⚠️ THEIR CLOCK, NOT OURS — the same rule as `Lead.receivedAt`.
  receivedAt        DateTime  @map("received_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation      Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  address           InboundAddress @relation(fields: [inboundAddressId], references: [id], onDelete: Restrict)
  lead              Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  forwardingRequest InboundForwardingRequest?

  @@unique([provider, providerMessageId])
  @@index([organisationId])
  @@index([organisationId, status, receivedAt(sort: Desc)])
  @@map("inbound_messages")
}

/// A channel account that belongs to an organisation (slice 3.2c, migration 0040).
///
/// 🚨 THIS TABLE IS HOW AN INBOUND MESSAGE FINDS ITS ORGANISATION, AND IT IS
/// THE ONLY WAY. Meta's webhook carries no tenant of ours — it names its own
/// asset ids. Every downstream act (a lead in a named organisation, and later a
/// reply sent as that customer) rests on this lookup, which is why the asset
/// index below is unique ACROSS THE WHOLE TABLE and deliberately not
/// organisation-scoped: two organisations claiming one phone number id would
/// file a stranger's enquiry in the wrong book.
///
/// Shared across the three Meta channels (founder ruling 65, 2026-09-03):
/// WhatsApp today, Messenger and Instagram on the same app, signature and
/// envelope later. The CHECK still permits only `whatsapp`; adding a channel
/// is a migration.
///
/// ⚠️ ONE INDEX CANNOT BE EXPRESSED HERE — the 0017/0034 precedent. Migration
/// 0040 creates `channel_connections_asset_key` as a PARTIAL unique index on
/// `(channel, external_account_id, COALESCE(external_asset_id, ''))
/// WHERE deleted_at IS NULL`. Prisma has no syntax for the COALESCE or the
/// WHERE, so the migration is the only record of it.
model ChannelConnection {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  /// Which product this connection serves. A mailbox belongs to ONE product
  /// (rulings 36/49) and a channel is the same kind of thing.
  moduleKey         String    @map("module_key")
  channel           String
  /// The account the asset hangs off: a WhatsApp Business Account id today, a
  /// Page id for Messenger, an Instagram account id later.
  externalAccountId String    @map("external_account_id")
  /// The thing messages actually arrive at: WhatsApp's phone number id. Null
  /// for channels where the account IS the endpoint.
  externalAssetId   String?   @map("external_asset_id")
  /// What a human would recognise it by — the display phone number. Never
  /// used for routing.
  displayName       String?   @map("display_name")
  /// connected | needs_reconnect | disconnected
  status            String    @default("connected")
  connectedBy       String?   @map("connected_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  organisation      Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  messages          InboundChannelMessage[]

  @@index([organisationId])
  @@map("channel_connections")
}

/// What arrived on a channel (slice 3.2c, migration 0040).
///
/// ⚠️ A SEPARATE TABLE FROM `InboundMessage`, ON PURPOSE. That one is email to
/// its bones — a NOT NULL address FK, a `delivered_to`, a `subject`, an
/// `html_body`. A WhatsApp delivery has a phone number, a message type and
/// text. Widening the email table would be four nullable columns and a FK that
/// stops meaning anything.
///
/// ⚠️ AND META KEEPS NO HISTORY. There is no API for fetching past webhooks;
/// what is not stored here is gone. `payload` is the message as it arrived.
///
/// ⚠️ ONE INDEX CANNOT BE EXPRESSED HERE. Migration 0040 creates
/// `inbound_channel_messages_waiting_idx` on `(organisation_id, received_at
/// DESC) WHERE status = 'received'`. Prisma has no partial-index syntax, so
/// the migration is the only record of it.
model InboundChannelMessage {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  connectionId      String    @map("connection_id") @db.Uuid
  channel           String
  /// ⚠️ THE IDEMPOTENCY KEY. Meta retries anything that does not answer 200 —
  /// for up to 7 days, to every app subscribed to the account. Unique per
  /// channel, so the second delivery is a no-op instead of a second enquiry.
  providerMessageId String    @map("provider_message_id")
  /// Who sent it, in the channel's own form: WhatsApp's `wa_id`, E.164 digits
  /// without the plus.
  fromIdentifier    String    @map("from_identifier")
  /// Their profile name, as WhatsApp reported it. Theirs, not ours.
  fromDisplayName   String?   @map("from_display_name")
  /// text | image | audio | video | document | sticker | location | contacts …
  /// Stored rather than filtered: a photo of the leaking roof may BE the enquiry.
  messageType       String    @map("message_type")
  /// Null for a message with no text at all (a bare image, a sticker).
  textBody          String?   @map("text_body")
  /// The message object verbatim, plus the sender's contact entry and the
  /// receiving number's metadata from the same webhook.
  payload           Json
  /// received | converted | ignored | failed
  status            String    @default("received")
  failureReason     String?   @map("failure_reason")
  /// Set when a message becomes a lead (3.3). Null until then.
  leadId            String?   @map("lead_id") @db.Uuid
  /// ⚠️ THEIR CLOCK, NOT OURS — the same rule as `Lead.receivedAt`.
  receivedAt        DateTime  @map("received_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection        ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  lead              Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([channel, providerMessageId], map: "inbound_channel_messages_provider_message_key")
  @@index([organisationId])
  @@map("inbound_channel_messages")
}

/// The wording Eva replies to an enquiry with (slice 3.1c-1, migration 0035).
///
/// ⚠️ THE LEAD PRODUCT'S FIRST OWNED TABLE, AND THE ONLY ONE IT OWNS. The LEAD
/// itself stays in `platform/` (ruling 56) because Lead Follow-up by Call and
/// the planned CRM are separate products that will want the same record, and a
/// product's tables are exclusively owned. What this product owns is the
/// REPLY — starting with the words it is written in.
///
/// Three defaults are created on first read (`ensureDefaultTemplates`), the
/// `ensureDefaultSequence` precedent. Every one of them is the customer's to
/// rewrite; that is the feature.
model LeadReplyTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  /// Which medium this wording is for (slice 3.2b, migration 0039). `email` is
  /// the only value the CHECK permits today; adding a channel is a migration.
  ///
  /// ⚠️ NOT THE SAME VOCABULARY AS `leads.source`, ON PURPOSE. That says
  /// `email_enquiry` and describes how an enquiry ARRIVED; this describes the
  /// medium Eva REPLIES on. Same wire, opposite directions.
  channel        String
  /// What the customer calls it in their own list. Never sent to anybody.
  name           String
  /// What Eva actually writes. Plain text: the mailbox adapters send text
  /// (`bodyText`), so offering rich text would promise formatting the send
  /// path does not carry.
  body           String
  /// ⚠️ EXACTLY ONE AUTOMATIC TEMPLATE PER ORGANISATION **PER CHANNEL**
  /// (ruling 55, widened by ruling 63) — the only thing Eva ever sends on her
  /// own on that medium. The rest are saved wordings a human picks from the
  /// enquiry screen.
  isAutomatic    Boolean      @default(false) @map("is_automatic")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  /// ⚠️ TWO PARTIAL UNIQUE INDEXES LIVE IN THE MIGRATIONS AND NOT HERE, because
  /// Prisma cannot express `WHERE` on an index — the 0011/0013/0017/0034
  /// precedent. Both were created by 0035 and **widened to include `channel` by
  /// 0039**: `lead_reply_templates_single_automatic_key` is one automatic reply
  /// per organisation PER CHANNEL among the live rows;
  /// `lead_reply_templates_live_name_key` is one name per organisation per
  /// channel, and it is what makes the lazy seeding idempotent without a
  /// bookkeeping column.
  ///
  /// ⚠️ AND `REVOKE DELETE` LIVES THERE TOO. Deletion is soft. A hard delete
  /// would take the wording Eva sent somebody out from under the evidence of
  /// having sent it.
  decisions      LeadReplyDecision[]

  @@map("lead_reply_templates")
}

/// What Eva decided about one enquiry, and what she sent (slice 3.1c-3,
/// migration 0036). The lead product's second owned table.
///
/// ⚠️ ONE ROW PER LEAD, AND IT EXISTS EVEN WHEN NOTHING WAS SENT. Ruling 32
/// means Eva often decides NOT to answer, and "she stayed silent" and "she was
/// never asked" look identical from outside. A customer opening an unanswered
/// enquiry has to be told which, in a sentence, or the silence reads as a fault.
///
/// ⚠️ THE BODY IS STORED, NOT JUST THE TEMPLATE ID. Customers edit templates
/// freely, so the template's wording today is not what was sent last month —
/// and this is the record of what a stranger actually received in their name.
model LeadReplyDecision {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  /// Which medium Eva answered on, or would have (slice 3.2b, migration 0039).
  /// Stored for the same reason the body is: this is the record of what a
  /// stranger actually received, and "by which means" is part of that.
  ///
  /// ⚠️ NULLABLE, UNLIKE `LeadReplyTemplate.channel`. A template always has a
  /// channel; a decision may not. `leads.source` still legally holds the three
  /// retired call-shaped values, and there is no channel Eva can answer those
  /// on — so NULL means "no channel could be determined, and nothing was sent".
  /// Writing `email` there would falsify the record. A CHECK in 0039 stops a
  /// null-channel row ever claiming it sent something.
  channel        String?
  /// reply | hold | never — the provider's answer (slice 3.1c-2).
  verdict        String
  /// Why, in words, for the enquiry screen.
  reason         String
  /// The stable key behind that sentence, for logs and metrics.
  signal         String
  /// pending | sent | failed | deferred | not_sent.
  /// ⚠️ `not_sent` IS A SUCCESS — the terminal state of a hold or never.
  status         String    @default("pending")
  failureReason  String?   @map("failure_reason")
  /// Null unless a reply was actually composed.
  templateId     String?   @map("template_id") @db.Uuid
  /// Where the reply went. ⚠️ EMAIL-NAMED, NOT EMAIL-ONLY: once WhatsApp lands
  /// this holds an E.164 phone number. Renaming it was considered and rejected
  /// in 0039 — it would touch every read and write of this table for a channel
  /// that did not exist yet. Read it as "recipient".
  toAddress      String?   @map("to_address")
  /// ⚠️ EMAIL ONLY, AND THE DATABASE ENFORCES IT. WhatsApp has no subject, so
  /// `lead_reply_decisions_subject_is_email_only_check` (0039) refuses a
  /// non-email row that carries one.
  subject        String?
  body           String?
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  /// Text, not a foreign key: the mailbox may be disconnected later and the
  /// record of who a stranger heard from must outlive it.
  sentFrom       String?   @map("sent_from")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// ⚠️ NO `createdBy`. Eva decides unattended; there is no person to name.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead           Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template       LeadReplyTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  /// ⚠️ THREE INDEXES AND FOUR CHECKS LIVE IN MIGRATION 0036, NOT HERE.
  /// `lead_reply_decisions_one_per_lead_key` is partial (`WHERE deleted_at IS
  /// NULL`) and is THE IDEMPOTENCY KEY — Resend retries a webhook that does not
  /// answer 200, and without it a retried delivery sends a stranger the same
  /// automatic reply twice. `lead_reply_decisions_waiting_idx` is the review
  /// queue's partial index. The CHECKs refuse a `sent` row that carries no body
  /// and a `sent` row whose verdict never allowed a reply. Prisma can express
  /// none of it — the 0011/0013/0017/0034/0035 precedent.
  @@map("lead_reply_decisions")
}
