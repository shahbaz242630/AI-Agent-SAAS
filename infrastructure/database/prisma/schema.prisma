// Eva — Phase 0 schema (BRD 10; Slice 0.2).
// Conventions (BRD 10): snake_case columns, tenant-owned rows carry
// organisation_id, mutable records carry created_at/updated_at/created_by,
// soft delete via deleted_at, all timestamps timestamptz (UTC, BRD 18.1).
// Phase 0 tables ONLY — invoicing/CRM/billing tables arrive with their phases
// (Rule 11: no placeholder debt).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  /// Demo/seed organisations are excluded from any real sending (BRD 18.6).
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  settings        OrganisationSettings?
  memberships     OrganisationMembership[]
  auditLogs       AuditLog[]
  customers       Customer[]
  contacts        Contact[]
  invoices        Invoice[]
  imports         Import[]
  importRows      ImportRow[]
  invoiceDocuments InvoiceDocument[]
  suppressionList SuppressionEntry[]
  rolePermissions OrganisationRolePermission[]
  reminderSequences ReminderSequence[]
  reminderSteps     ReminderStep[]
  scheduledActions  ScheduledAction[]
  humanEscalations  HumanEscalation[]
  emailAccounts   EmailAccount[]
  modules         OrganisationModule[]

  @@map("organisations")
}

model OrganisationSettings {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @unique @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// All business logic runs in this timezone (BRD 18.1).
  timezone       String       @default("Europe/London")
  locale         String       @default("en-GB")
  /// Shapes refined when the modules that consume them land (Phases 1-4).
  /// Calling hours default to the UK 08:00-21:00 rule (BRD 17) but are per-org
  /// CONFIGURATION, not a code constant — BRD 18.7 (jurisdiction-as-config)
  /// supersedes any hard UK clamp, since the launch market is UK but GCC and
  /// US follow (18.7.1). Phase 2 must read these, never hardcode a country.
  businessHours  Json?        @map("business_hours")
  callingHours   Json?        @map("calling_hours")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@map("organisation_settings")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  /// Lowercased by the application layer before write.
  email       String    @unique
  fullName    String?   @map("full_name")
  /// Links to Supabase Auth (auth.users.id); populated in Slice 0.3.
  authUserId  String?   @unique @map("auth_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  memberships OrganisationMembership[]
  auditLogs   AuditLog[]

  @@map("users")
}

/// The six roles of BRD 7, seeded by src/seed.ts.
model Role {
  id              String                       @id @default(uuid()) @db.Uuid
  key             String                       @unique
  name            String
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships     OrganisationMembership[]
  rolePermissions OrganisationRolePermission[]

  @@map("roles")
}

model OrganisationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@unique([organisationId, userId])
  @@map("organisation_memberships")
}

/// Append-only audit trail (BRD 15): never updated, never soft-deleted.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  /// Null for system actions.
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id])

  @@index([organisationId, createdAt])
  @@map("audit_logs")
}

// --- Slice 1.1: CRM core + data-driven permissions (BRD 10; plan §7 ruling) ---

/// A business the organisation sells to / is owed money by (BRD 10 — CRM core).
model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  name           String
  /// Lowercased by the application layer before write.
  email          String?
  phone          String?
  /// The organisation's own account reference for this customer.
  reference      String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  invoices       Invoice[]

  @@index([organisationId])
  @@map("customers")
}

/// A person at a customer — reminders are addressed to contacts (BRD 10).
/// organisation_id is denormalised onto every tenant-owned row so the RLS
/// tenant_isolation policy stays uniform.
model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  name           String
  /// Lowercased by the application layer before write.
  email          String?
  phone          String?
  jobTitle       String?      @map("job_title")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@index([organisationId])
  @@index([customerId])
  @@map("contacts")
}

// --- Slice 1.2: invoice records (BRD 4.1/10; Phase 1.2 plan §3) ---

/// An amount owed by a customer (BRD 10). Status is one of the nine STORED
/// statuses (CHECK constraint in migration 0006): draft, active, paused,
/// cancelled, promise_to_pay, disputed, partially_paid, paid, written_off.
/// due_soon/due_today/overdue are NOT stored — they are derived at read time
/// from due_date + the organisation timezone (plan §7.1). status changes only
/// via the invoices module state machine (BRD 4.1 hard rule).
/// Uniqueness of invoice_number per organisation among live rows is enforced
/// by a partial unique index (migration 0006), so a soft-deleted invoice's
/// number can be reused.
model Invoice {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  /// Optional link to the person reminders are addressed to (plan §7.2);
  /// SET NULL when the contact is deleted.
  contactId        String?      @map("contact_id") @db.Uuid
  /// The organisation's own invoice number (unique per org among live rows).
  invoiceNumber    String       @map("invoice_number")
  /// Integer minor units (pence) — money is never float (BRD 10).
  amountMinorUnits Int          @map("amount_minor_units")
  currency         String       @default("GBP") @db.Char(3)
  issueDate        DateTime     @map("issue_date") @db.Date
  dueDate          DateTime     @map("due_date") @db.Date
  status           String       @default("draft")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  importRows       ImportRow[]
  invoiceDocuments InvoiceDocument[]
  scheduledActions ScheduledAction[]
  humanEscalations HumanEscalation[]

  @@index([organisationId])
  @@index([customerId])
  @@map("invoices")
}

// --- Slice 1.3: CSV/Excel invoice import (BRD 4.1/10/15/16; Phase 1.3 plan §3/§7) ---

/// One row per uploaded import file (plan §7.1: persisted two-phase import).
/// The file itself is NEVER persisted — held in memory, parsed, discarded
/// (BRD 16 data minimisation); only staged rows in import_rows survive.
/// status is one of uploaded | completed | failed | cancelled (CHECK
/// constraint in migration 0007); 'confirmed' is not a stored state — confirm
/// runs synchronously to completion (plan §7.8). Status changes only via the
/// imports module status machine (the 1.2 pattern).
model Import {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  originalFilename String       @map("original_filename")
  /// csv | xlsx (CHECK constraint in migration 0007). Legacy .xls rejected.
  fileType         String       @map("file_type")
  status           String       @default("uploaded")
  /// Resolved file-column → canonical-field mapping (echoed to the client).
  mapping          Json
  totalRows        Int          @default(0) @map("total_rows")
  validRows        Int          @default(0) @map("valid_rows")
  invalidRows      Int          @default(0) @map("invalid_rows")
  duplicateRows    Int          @default(0) @map("duplicate_rows")
  suppressedRows   Int          @default(0) @map("suppressed_rows")
  createdRows      Int          @default(0) @map("created_rows")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rows             ImportRow[]

  @@index([organisationId])
  @@map("imports")
}

/// A staged parse result — one row per data row of the uploaded file
/// (plan §3). organisation_id is denormalised onto every tenant-owned row so
/// the RLS tenant_isolation policy stays uniform (the contacts precedent).
/// No deleted_at: lifecycle follows the parent import via cascade.
/// status is one of valid | invalid | duplicate | suppressed | imported |
/// skipped (CHECK constraint in migration 0007).
model ImportRow {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  importId         String       @map("import_id") @db.Uuid
  /// 1-based position of the data row in the uploaded file.
  rowNumber        Int          @map("row_number")
  /// The original file row (file column names → raw string values).
  raw              Json
  status           String
  /// Row-level validation errors (jsonb string array); empty when valid.
  errors           Json         @default("[]")
  /// The Draft invoice created at confirm (plan §7.7); SET NULL if that
  /// invoice is deleted.
  createdInvoiceId String?      @map("created_invoice_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  import           Import       @relation(fields: [importId], references: [id], onDelete: Cascade)
  createdInvoice   Invoice?     @relation(fields: [createdInvoiceId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([importId])
  @@map("import_rows")
}

// --- Slice 1.4: PDF invoice extraction (BRD 4.1/10/15/16; Phase 1.4 plan §3/§7) ---

/// One uploaded single-invoice PDF plus its extraction outcome (plan §3).
/// Unlike imports (1.3), the PDF itself IS persisted in `content` (bytea,
/// RLS-protected — plan §7.2): review needs source-beside-fields, the
/// manual-entry fallback needs the file readable, and it is the attachment
/// source when Outlook sending lands in slice 1.7 (BRD 16).
/// status is one of uploaded | extracted | confirmed | failed (CHECK
/// constraint in migration 0008); status changes only via the
/// invoice-documents module status machine (the 1.2/1.3 pattern).
model InvoiceDocument {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  originalFilename String       @map("original_filename")
  sizeBytes        Int          @map("size_bytes")
  /// The PDF bytes (plan §7.2). Never logged (BRD 14); streamed back only
  /// through the tenant-scoped file endpoint.
  content          Bytes
  status           String       @default("uploaded")
  /// Extraction draft: per canonical field `{ value, confidence }` plus
  /// extraction notes (plan §3); null until extraction has run.
  extractedFields  Json?        @map("extracted_fields")
  /// Sanitised, actionable failure reason when status = 'failed' (plan §3) —
  /// never raw extractor internals.
  extractionError  String?      @map("extraction_error")
  /// The Draft invoice created at confirm (plan §7.7); SET NULL if that
  /// invoice is deleted.
  invoiceId        String?      @map("invoice_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice          Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@map("invoice_documents")
}

/// Permanent, cross-channel do-not-contact record (BRD hard rule: actioned
/// immediately and permanently, across all channels). No updated_at/deleted_at:
/// entries are NEVER updated or deleted — migration 0005 also revokes
/// UPDATE/DELETE from the runtime role so permanence holds at the database
/// layer, not just in app code. Channels: email | call (whatsapp added
/// additively when Phase 3 needs it).
model SuppressionEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  channel        String
  /// The suppressed address/number, normalised by the application layer.
  value          String
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Re-adding the same value on the same channel is idempotent (upsert key).
  @@unique([organisationId, channel, value])
  @@map("suppression_list")
}

/// Per-organisation role→permission grants (BRD 7 amendment, Slice 1.1 plan
/// §7.1). An org with ZERO rows uses the coded BRD default matrix
/// (DEFAULT_ROLE_PERMISSIONS in @eva/types); rows appear only when an
/// owner/administrator saves a custom mapping (full-replace PUT, audit-logged).
/// Rows are replaced, not edited in place — history lives in audit_logs.
model OrganisationRolePermission {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  permissionKey  String       @map("permission_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organisationId, roleId, permissionKey])
  @@map("organisation_role_permissions")
}

// --- Slice 1.5: reminder sequence (BRD 4.1/10; Phase 1.5 plan §3) ---

/// The organisation's reminder sequence of BRD 4.1 stages (plan §3). One
/// default per organisation among LIVE rows is enforced by a partial unique
/// index (migration 0009), so a soft-deleted default can be replaced.
model ReminderSequence {
  id             String          @id @default(uuid()) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  name           String
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?         @map("created_by") @db.Uuid
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  steps          ReminderStep[]

  @@index([organisationId])
  @@map("reminder_sequences")
}

/// One BRD 4.1 stage of a sequence (plan §3). key is one of pre_due_3 |
/// due_date | overdue_7 | overdue_14 | overdue_30 | final_escalation and
/// action_type one of email | internal_escalation (CHECK constraints in
/// migration 0009). offset_days is relative to the invoice due_date
/// (negative = before). organisation_id is denormalised onto every
/// tenant-owned row so the RLS tenant_isolation policy stays uniform (the
/// contacts precedent). Uniqueness of key per sequence among live rows is
/// enforced by a partial unique index (migration 0009).
model ReminderStep {
  id               String            @id @default(uuid()) @db.Uuid
  organisationId   String            @map("organisation_id") @db.Uuid
  sequenceId       String            @map("sequence_id") @db.Uuid
  key              String
  offsetDays       Int               @map("offset_days")
  actionType       String            @map("action_type")
  enabled          Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?           @map("created_by") @db.Uuid
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sequence         ReminderSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  scheduledActions ScheduledAction[]

  @@index([organisationId])
  @@index([sequenceId])
  @@map("reminder_steps")
}

/// One durable send-queue row: a reminder (or internal escalation) due on an
/// org-local calendar day (plan §3). status is the full lifecycle — pending |
/// ready | claimed | sent | failed | skipped | cancelled (CHECK constraint in
/// migration 0009, the 1.2 invoice-status precedent); slice 1.5 writes only
/// pending/ready/cancelled, 1.7 drives the rest. action_type is denormalised
/// from the step so escalations fire without a step join. UNIQUE
/// (invoice_id, reminder_step_id, scheduled_date) is the BRD 4.1 mandatory
/// duplicate prevention; idempotency_key is the deterministic uuidv5 of
/// invoice+step+date, generated app-side. No deleted_at: a lifecycle/queue
/// record — cancelled is terminal.
model ScheduledAction {
  id              String           @id @default(uuid()) @db.Uuid
  organisationId  String           @map("organisation_id") @db.Uuid
  invoiceId       String           @map("invoice_id") @db.Uuid
  reminderStepId  String           @map("reminder_step_id") @db.Uuid
  actionType      String           @map("action_type")
  /// The org-local calendar day the action is due (like invoices.due_date).
  scheduledDate   DateTime         @map("scheduled_date") @db.Date
  status          String           @default("pending")
  idempotencyKey  String           @map("idempotency_key")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid
  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reminderStep    ReminderStep     @relation(fields: [reminderStepId], references: [id], onDelete: Cascade)
  humanEscalation HumanEscalation?

  /// BRD 4.1 duplicate prevention over LIVE rows only: uniqueness of
  /// (invoice_id, reminder_step_id, scheduled_date) WHERE status <> 'cancelled'
  /// is enforced by a partial unique index (migration 0011, the 0009
  /// precedent). A cancelled slot can be re-filled by a fresh insert —
  /// cancelled is terminal, rows are never revived.
  @@index([organisationId])
  @@index([status, scheduledDate])
  @@map("scheduled_actions")
}

/// A platform workflow record raised when the final reminder fires (plan §3).
/// scheduled_action_id is UNIQUE — one escalation per fired step (the dedup).
/// status is open | resolved (CHECK constraint in migration 0009); resolution
/// is its lifecycle, so no deleted_at.
model HumanEscalation {
  id                String          @id @default(uuid()) @db.Uuid
  organisationId    String          @map("organisation_id") @db.Uuid
  invoiceId         String          @map("invoice_id") @db.Uuid
  scheduledActionId String          @unique @map("scheduled_action_id") @db.Uuid
  reason            String
  status            String          @default("open")
  resolvedAt        DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolvedBy        String?         @map("resolved_by") @db.Uuid
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.Uuid
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  scheduledAction   ScheduledAction @relation(fields: [scheduledActionId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("human_escalations")
}

/// A connected Microsoft 365 mailbox (Slice 1.6; BRD §8 email_accounts).
/// OAuth tokens are AES-256-GCM ciphertext (v1.<iv>.<tag>.<ct> base64 — see
/// apps/api common/crypto), NEVER plaintext; both are nulled on disconnect
/// (ruling 8). health_status is active | auth_expired | error (CHECK in
/// migration 0013). One LIVE connection per organisation: partial unique
/// index WHERE deleted_at IS NULL (ruling 6, the 0011 precedent).
model EmailAccount {
  id                    String       @id @default(uuid()) @db.Uuid
  organisationId        String       @map("organisation_id") @db.Uuid
  provider              String       @default("microsoft")
  emailAddress          String       @map("email_address")
  displayName           String?      @map("display_name")
  accessTokenEncrypted  String?      @map("access_token_encrypted")
  refreshTokenEncrypted String?      @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?    @map("token_expires_at") @db.Timestamptz(6)
  scopes                String[]
  healthStatus          String       @default("active") @map("health_status")
  lastHealthCheckAt     DateTime?    @map("last_health_check_at") @db.Timestamptz(6)
  lastError             String?      @map("last_error")
  connectedBy           String?      @map("connected_by") @db.Uuid
  /// The mailbox 1.7 sends from. Exactly one per organisation, enforced by a
  /// partial unique index (migration 0017) that schema.prisma cannot express.
  isPrimary             Boolean      @default(false) @map("is_primary")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?      @map("created_by") @db.Uuid
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("email_accounts")
}

/// Which of the four products an organisation holds, and how many units of
/// each it has paid for. Absence of a row means NOT entitled — fail closed.
///
/// The partial unique index on (organisation_id, module_key) WHERE deleted_at
/// IS NULL lives in migration 0017: partial indexes are not representable
/// here, the 0011/0013 precedent.
model OrganisationModule {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  moduleKey      String       @map("module_key")
  enabled        Boolean      @default(true)
  /// How it was turned on: subscription | manual | trial.
  source         String       @default("manual")
  /// Units paid for — a connected mailbox for the email credit controller.
  /// NOT NULL by design: a NULL meaning "unlimited" would fail open.
  seats          Int          @default(1)
  enabledAt      DateTime?    @map("enabled_at") @db.Timestamptz(6)
  disabledAt     DateTime?    @map("disabled_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("organisation_modules")
}
