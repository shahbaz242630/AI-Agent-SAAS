# ── Eva platform — example environment file ──────────────────────────────
# Copy to .env for local dev. NEVER commit a real .env (see .gitignore).
# Real secrets live in Railway / Supabase / GitHub Environments (BRD 9.10).

# Shared
NODE_ENV=development
LOG_LEVEL=info

# API (apps/api)
PORT=3001
# Postgres — local Docker Compose default (used by @eva/database since Slice 0.2)
DATABASE_URL=postgresql://eva:eva@localhost:5432/eva
# Runtime API connection as the eva_app role (NOBYPASSRLS) — RLS applies (Slice 0.3)
APP_DATABASE_URL=postgresql://eva_app:eva_app@localhost:5432/eva

# Worker (apps/worker) — Trigger.dev v4 (locked 2026-07-22); tasks run on Trigger.dev Cloud
# Project ref from the Trigger.dev dashboard; secret key stays EMPTY here (Slice 0.4/staging)
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Base URL the worker uses for internal API calls (Slice 1.5 reconcile sweep)
API_BASE_URL=http://localhost:3001

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Where Eva lives, as far as every link it EMAILS is concerned (Slice 1.10g).
# ⚠️ Required: the web server refuses to start without it, on purpose. Taking
# this from the incoming request instead is how confirmation and reset links
# ended up pointing at https://localhost:8080 on production (2026-08-11), and
# trusting the forwarded host would turn that bug into password-reset poisoning.
# ⚠️ Must also appear in Supabase → Authentication → URL Configuration →
# Redirect URLs, which is the independent second lock on where a link may land.
WEB_PUBLIC_ORIGIN=http://localhost:3006

# Supabase (Slice 0.3) — placeholders only
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Web browser-side Supabase access (Slice 0.5) — same project; the anon key is public-by-design
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (Slice 0.4) — placeholders only. DSNs are public-by-design.
SENTRY_DSN_API=
# Feeds NEXT_PUBLIC_SENTRY_DSN for the browser bundle via apps/web/next.config.ts
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=
# CI-only source-map upload token (GitHub/Railway secret). NEVER put the real value here.
SENTRY_AUTH_TOKEN=

# Internal service-to-service secret (Slice 1.5) — guards POST /internal/* endpoints
# (the Trigger.dev reconcile sweep). Min 32 chars; real value lives in Railway secrets.
INTERNAL_API_SECRET=local-dev-only-internal-secret-change-me # gitleaks:allow — placeholder, not a real secret

# --- Slice 1.6: Outlook connection (api) ---
# 32 bytes, base64 — generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me-base64-32-bytes
# HS256 secret for OAuth state JWTs — generate: openssl rand -base64 32
OAUTH_STATE_SECRET=replace-me-min-32-chars
# Multi-tenant Entra app registration (see docs/Phase 1.6/PHASE-1.6-PLAN.md §10)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3001/integrations/microsoft/callback

# --- Slice 3.1b: the inbound front door (ruling 25 — an address WE own) ---
# The domain a customer's enquiries are delivered to. Ruling 34 starts this on
# Resend's free `<id>.resend.app` and moves it to a domain we own before the
# first sale. Leave EMPTY where inbound is not configured: unset means "no
# address can be issued", never "invent one" — an address on a domain that
# receives nothing would be printed on a customer's website and lose every
# enquiry sent to it, silently.
INBOUND_EMAIL_DOMAIN=
# Reading the message a webhook only names. Resend's `email.received` payload
# carries metadata only, so the body and headers take a second call.
RESEND_API_KEY=
# Svix signing secret (`whsec_…`) for POST /integrations/resend/inbound.
# This is the ONLY authentication on that route — there is no JWT on a webhook.
# Unset means REFUSE EVERYTHING; it must never fall through to "unverified, so
# allow it".
RESEND_WEBHOOK_SECRET=

# --- Slice 3.1b: Gmail sending (ruling 25 — the CHEAP scope only) ---
# From a Google Cloud OAuth client (Web application). The redirect URI must be
# registered there EXACTLY as written below, or Google refuses the callback.
#
# ⚠️ SCOPES: `gmail.send` AND NOTHING THAT CAN READ A MAILBOX. Every reading
# scope — including `gmail.metadata`, which sees only sender and subject — is
# RESTRICTED on Google's classification: a security assessment every 12 months,
# 4-12 weeks to approval, a 100-user cap until it clears. Sending is merely
# sensitive: one review, no audit, no fee.
#
# ⚠️ WHILE THE OAUTH APP IS IN "TESTING" PUBLISHING STATUS, GOOGLE EXPIRES THE
# GRANT — AND ITS REFRESH TOKEN — SEVEN DAYS AFTER CONSENT. Mailboxes will need
# reconnecting weekly until the app is moved to "In Production". That is
# Google's behaviour, not a defect in Eva.
#
# Left empty, the Gmail card is offered but connecting is refused with a clear
# message; Microsoft is unaffected either way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/integrations/google/callback
