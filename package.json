{
  "name": "eva-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Eva \u2014 AI business communications platform (BRD v1.2)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r --if-present run lint",
    "boundaries": "pnpm run boundaries:api && pnpm run boundaries:web",
    "boundaries:api": "depcruise apps/api/src apps/api/test --config .dependency-cruiser.cjs",
    "boundaries:web": "depcruise apps/web/src apps/web/test --config .dependency-cruiser.web.cjs",
    "boundaries:graph": "depcruise apps/api/src apps/api/test --config .dependency-cruiser.cjs --output-type dot",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @eva/database run db:generate",
    "db:migrate": "pnpm --filter @eva/database run db:migrate",
    "db:seed": "pnpm --filter @eva/database run db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@sentry/cli",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "qs": ">=6.16.0",
      "postcss": ">=8.5.23 <9",
      "next>sharp": ">=0.35.0",
      "tar": ">=7.5.21",
      "valibot": ">=1.4.2",
      "@hono/node-server": ">=2.0.5",
      "@opentelemetry/core": ">=2.8.0",
      "engine.io": ">=6.6.7",
      "ws": ">=8.21.0",
      "esbuild": ">=0.25.0",
      "find-my-way": ">=9.7.0",
      "exceljs>uuid": "^11.1.1",
      "nanoid": ">=3.3.18 <4",
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.22.0",
      "fast-uri": ">=3.1.6 <4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
